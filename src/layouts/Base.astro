---
// Every page: head, top bar, main, footer. Only system fonts and one inline stylesheet.
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Seo, { type Props as SeoProps } from "../components/Seo.astro";
import Analytics from "../components/Analytics.astro";
import { siteConfig } from "../config";
import "../styles/global.css";

type Props = SeoProps;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- The visitor's light/dark pick, applied before first paint so the page never flashes the other theme. -->
    <script is:inline>try { const t = localStorage.getItem("theme"); if (t === "light" || t === "dark") document.documentElement.dataset.theme = t; } catch {}</script>
    <Seo {...Astro.props} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f6f0e1" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#1b1915" />
    <meta name="color-scheme" content="light dark" />
    {siteConfig.analytics.searchConsole && <meta name="google-site-verification" content={siteConfig.analytics.searchConsole} />}
    <slot name="head" />
    <Analytics />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <slot name="end" />
  </body>
</html>

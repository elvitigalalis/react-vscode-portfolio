---
// Every page: head, top bar, main, footer. Only system fonts and one inline stylesheet.
// Each page imports its base stylesheet (global.css) first, so a page can bring its own instead.
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Seo, { type Props as SeoProps } from "../components/Seo.astro";
import Analytics from "../components/Analytics.astro";
import { siteConfig } from "../config";

type Props = SeoProps;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- The visitor's light/dark pick, applied before first paint so the page never flashes the other theme. -->
    {/* And again when Back/Forward restores the page from the bfcache with the theme it had then. */}
    <script is:inline data-theme-init>(() => { const r = document.documentElement, pick = () => { try { const t = localStorage.getItem("theme"); if (t === "light" || t === "dark") r.dataset.theme = t; else delete r.dataset.theme; } catch {} }; pick(); addEventListener("pageshow", (e) => e.persisted && pick()); })();</script>
    <Seo {...Astro.props} />
    <!-- The two fonts (global.css), fetched in parallel with the stylesheet. -->
    <link rel="preload" href="/fonts/fraunces-display.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-text.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f9f3ea" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#1b1915" />
    <meta name="color-scheme" content="light dark" />
    {siteConfig.analytics.searchConsole && <meta name="google-site-verification" content={siteConfig.analytics.searchConsole} />}
    <slot name="head" />
    <Analytics />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <slot name="end" />
  </body>
</html>

---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Projects from "../components/Projects.astro";
import Experience from "../components/Experience.astro";
import Education from "../components/Education.astro";
import Skills from "../components/Skills.astro";
import { siteConfig } from "../config";
import { frontmatter as content } from "../content/home.md";
---

<Base title={`${siteConfig.title} – ${content.kicker}`} description={siteConfig.description} path="/">
  <Hero />
  <Projects />
  <Experience />
  <Education />
  <Skills />
  <!-- Old links such as /#/projects (the previous site's hash routes) land on #projects. -->
  <script is:inline slot="end">
    var m = /^#\/([a-z]*)/.exec(location.hash);
    if (m) {
      var alias = { "": "top", overview: "top", docs: "top", languages: "skills", accomplishments: "education", certificates: "education" };
      location.replace("#" + (alias[m[1]] || m[1]));
    }
  </script>
</Base>

  </section>
</Base>

<script>
  import { configured, publicWeek, publicDays, publicNow } from "../../sheet/api.mjs";
  import { renderPublicWeek, scrollToToday } from "../../sheet/public.mjs";
  import { SHEET } from "../../site.mjs";
  import { localNow, weekDays, rightNow } from "../../sheet/logic.mjs";

  const root = document.querySelector(".sheet-page");
  const status = root.querySelector("[data-status]");
  const writeups = new Set(root.dataset.writeups.split(" ").filter(Boolean));

  async function refreshNow() {
    const row = await publicNow();
    const line = rightNow(row);
    root.querySelector(".sheet-now").classList.toggle("is-empty", !line);
    root.querySelector("[data-now]").textContent = line ?? "";
    if (row?.updated_on) {
      const d = new Date(`${row.updated_on}T12:00:00Z`).toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric", timeZone: "UTC" });
      root.querySelector("[data-updated]").textContent = `Last updated ${d}.`;
    }
  }

  async function load() {
    if (!configured) { status.textContent = "The planner is not set up yet."; return; }
    const today = localNow(new Date(), SHEET.timeZone).day;
    const days = weekDays(today);
    try {
      const [tasks, stamps] = await Promise.all([publicWeek(days[0], days[6]), publicDays(days[0], days[6]), refreshNow()]);
      renderPublicWeek(root.querySelector("[data-week]"), { days, today, tasks, stamps, writeups });
      scrollToToday(root.querySelector("[data-week]"));
      setInterval(() => refreshNow().catch(() => {}), 60_000);
    } catch {
      status.textContent = "Could not load this week. Try again in a minute.";
    }
  }
  load();
</script>

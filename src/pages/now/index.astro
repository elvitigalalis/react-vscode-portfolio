---
// The Sheet's public view (docs/sheet.md): this week, public tasks by title, private ones as bars.
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { siteConfig } from "../../config";
import "../../styles/sheet.css";
import { SHEET } from "../../site.mjs";

const writeups = (await getCollection("writeups")).map((w) => w.id);
---

<Base title={`Now · ${siteConfig.title}`} description="What Lisul Elvitigala is working on this week, from his planner. Private tasks show as black bars." path="/now/" noindex>
  {SHEET.supabaseUrl && <link slot="head" rel="preconnect" href={SHEET.supabaseUrl} crossorigin />}
  <section class="sheet-page" data-writeups={writeups.join(" ")}>
    <h1>Now</h1>
    <p class="sheet-now is-empty"><span class="sheet-label">Right now</span> <span data-now></span></p>
    <div class="sheet-week sheet-week-public" data-week aria-label="This week" role="group">
      <p class="sheet-status" data-status>Loading this week…</p>
    </div>
    <p class="sheet-ps">P.S. the redacted bars are life stuff.</p>
    <p class="small" data-updated></p>


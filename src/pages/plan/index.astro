---
// The Sheet's planner (docs/sheet.md): Lisul's week, behind his Google sign-in.
import Base from "../../layouts/Base.astro";
import { siteConfig } from "../../config";
import { SHEET } from "../../site.mjs";
import "../../styles/sheet.css";
---

<Base title={`Plan · ${siteConfig.title}`} description="Lisul Elvitigala's weekly planner. Only he can sign in; the public view is at /now." path="/plan/" noindex>
  {SHEET.supabaseUrl && <link slot="head" rel="preconnect" href={SHEET.supabaseUrl} crossorigin />}
  <section class="sheet-page sheet-planner">
    <!-- The top bar (docs/sheet-glance.md, change 6): ‹ Today › (‹ Tue Nov 3 › on phones, where
         the arrows step a day), Plan today, Shut down in its window, chips, Nudges and a ⋯ menu.
         src/sheet/topbar.mjs keeps its labels and the menu; feed-status.mjs the Feed failed chip;
         needs-you.mjs the Needs you chip (docs/sheet-morning.md, "/plan"). -->
    <div class="sheet-bar-top">
      <h1 data-week-title>Plan</h1>
      <div class="sheet-tools" data-tools hidden>
        <span class="sheet-nav">
          <button type="button" class="sheet-btn sheet-icon-btn" data-act="prev" aria-label="Previous week"><svg class="sheet-icon" aria-hidden="true"><use href="#i-chevron-left"></use></svg></button>
          <button type="button" class="sheet-btn" data-act="this-week"><span class="sheet-wide">Today</span><span class="sheet-narrow" data-focus-day></span></button>
          <button type="button" class="sheet-btn sheet-icon-btn" data-act="next" aria-label="Next week"><svg class="sheet-icon" aria-hidden="true"><use href="#i-chevron-right"></use></svg></button>
        </span>
        <button type="button" class="sheet-btn primary" data-act="plan">Plan<span class="sheet-chip-text"> today</span> <kbd>P</kbd></button>
        <button type="button" class="sheet-btn" data-act="shutdown" hidden><svg class="sheet-icon" aria-hidden="true"><use href="#i-moon"></use></svg><span class="sheet-chip-text">Shut down</span> <kbd>O</kbd></button>
        <!-- Status chips: Needs you first, then Feed failed. -->
        <span class="sheet-chips" data-chips>
          <button type="button" class="sheet-chip" data-act="needs" data-needs-chip aria-haspopup="dialog" hidden><svg class="sheet-icon" aria-hidden="true"><use href="#i-mail"></use></svg><span class="sheet-chip-text">Needs you · </span><span data-needs-n></span></button>
          <button type="button" class="sheet-chip is-alert" data-act="settings" data-feed-alert hidden><svg class="sheet-icon" aria-hidden="true"><use href="#i-circle-alert"></use></svg><span class="sheet-chip-text">Feed failed</span></button>
        </span>
        <button type="button" class="sheet-btn sheet-nudges" data-act="telegram" aria-pressed="false" title="Telegram nudges. While they're off, blocks get Google's default alert"><svg class="sheet-icon" aria-hidden="true"><use href="#i-bell-off"></use></svg><span class="sheet-chip-text">Nudges</span></button>
        <button type="button" class="sheet-btn sheet-icon-btn" popovertarget="sheet-more" aria-label="More: gym, calendars, settings, help, sign out"><svg class="sheet-icon" aria-hidden="true"><use href="#i-more-horizontal"></use></svg></button>
      </div>
    </div>
    <!-- On phones the bar holds ‹ day ›, Plan, Needs you, Nudges and ⋯ (sheet.css), so Gym lives
         here, a failed feed shows as a dot on ⋯ and the Feed failed item below, and in the shutdown
         window Plan today moves here to make room for Shut down. -->
    <div class="sheet-menu" id="sheet-more" data-more popover>
      <button type="button" class="is-alert" data-act="settings" data-feed-menu><svg class="sheet-icon" aria-hidden="true"><use href="#i-circle-alert"></use></svg> Feed failed</button>
      <button type="button" data-act="plan" data-plan-menu>Plan today</button>
      <a href="/plan/gym/"><svg class="sheet-icon" aria-hidden="true"><use href="#i-dumbbell"></use></svg> Gym</a>
      <button type="button" data-act="calendars">Calendars</button>
      <button type="button" data-act="settings">Settings <kbd>S</kbd></button>
      <button type="button" data-act="help">Help <kbd>?</kbd></button>
      <button type="button" data-act="sign-out">Sign out</button>
    </div>
    <!-- Messages to Claude (docs/sheet-messages.md): src/sheet/message-box.mjs sends them and
         lists the newest 10 with what each added. Hidden until the owner's settings load. -->
    <form class="sheet-message" data-message-form hidden>
      <label class="visually-hidden" for="sheet-message">Message to Claude</label>
      <textarea id="sheet-message" rows="1" maxlength="8000" autocomplete="off" required aria-describedby="sheet-message-hint" placeholder="Tell Claude, or paste a message…"></textarea>
      <button type="submit" class="sheet-btn primary">Send<span class="visually-hidden"> to Claude</span></button>
      <p class="sheet-message-hint" id="sheet-message-hint"><span class="sheet-message-keys"><kbd>⌘</kbd>/<kbd>Ctrl</kbd>+<kbd>Enter</kbd> sends. </span>Paste a class announcement and Claude adds its deadlines and dates. <span data-message-count></span></p>
    </form>
    <details class="sheet-message-recent" data-message-recent hidden>
      <summary>Recent messages to Claude</summary>
      <ul class="sheet-message-log" data-message-log aria-live="polite"></ul>
    </details>
    <p class="sheet-status" data-status>Loading…</p>
    <p class="sheet-notice" data-notice hidden></p>
    <p class="sheet-notice" role="status" data-mail-notice hidden></p>
    <p class="sheet-notice" data-events-stale hidden>Google Calendar needs reconnecting to show new events. <button type="button" class="sheet-link" data-act="connect">Reconnect Google Calendar in Settings</button></p>
    <div class="sheet-week" data-week aria-label="Week" role="group"></div>
    <h2 class="sheet-someday-title" data-someday-title hidden>Someday</h2>
    <div class="sheet-someday" data-someday></div>

    <div class="sheet-menu" data-menu popover>
      <button type="button" data-move="today">To today</button>
      <button type="button" data-move="tomorrow">To tomorrow</button>
      <button type="button" data-move="next-week">To next week</button>
      <button type="button" data-move="day-before">Day before</button>
      <button type="button" data-move="day-after">Day after</button>
      <button type="button" data-move="someday">To Someday</button>
      <button type="button" data-move="visibility">Make private</button>
      <button type="button" data-move="clear-due" hidden>Clear due date</button>
      <button type="button" data-move="delete">Delete</button>
    </div>

    <!-- Event to-dos (docs/sheet-v5.md, "Event to-dos"): a calendar event's row menu. -->
    <div class="sheet-menu" data-evmenu popover>
      <button type="button" data-act="evtodo-open">Open in Calendar</button>
      <button type="button" data-act="evtodo-hide">Hide</button>
    </div>

    <div class="sheet-toast" role="status" data-toast hidden>
      <span data-toast-text></span> <button type="button" class="sheet-link" data-act="undo">Undo</button>
    </div>

    <dialog class="sheet-dialog" data-help aria-labelledby="sheet-help-title">
      <h2 id="sheet-help-title">Keys</h2>
      <dl class="sheet-keys">
        <dt>Enter</dt><dd>Add the task, start the next</dd>
        <dt>~45m · @3pm · #tag</dt><dd>Estimate, fixed time, tag</dd>
        <dt>^fri · ^10/30 · ^tomorrow</dt><dd>Due date; at risk (⚠) within two days with no block</dd>
        <dt>!p</dt><dd>Private: /now shows a bar, Google says Busy</dd>
        <dt>P</dt><dd>Plan today</dd>
        <dt>O</dt><dd>Shut down</dd>
        <dt>D · Z</dt><dd>While planning: tomorrow, Someday</dd>
        <dt>↑ ↓</dt><dd>While planning: move the focused block 15 min</dd>
        <dt>A · Shift+A</dt><dd>While planning: approve the focused block, approve all</dd>
        <dt>← →</dt><dd>Previous or next week</dd>
        <dt>T</dt><dd>This week</dd>
        <dt>.</dt><dd>Menu for the focused task</dd>
        <dt>⌘Z</dt><dd>Undo</dd>
        <dt>S</dt><dd>Settings: mail accounts, calendar, interest profile, habits, feeds</dd>
        <dt>C</dt><dd>Campus events for the focused day (or the campus chip under its calendar)</dd>
        <dt>M</dt><dd>Needs you: mail waiting on you (or the Needs you chip)</dd>
      </dl>
      <!-- What each icon means (docs/sheet-glance.md, "The icon set"). One line per icon in use. -->
      <h3 class="sheet-legend-title">Icons</h3>
      <dl class="sheet-keys sheet-legend">
        <dt><svg class="sheet-icon" aria-hidden="true"><use href="#i-lock"></use></svg><span class="visually-hidden">Lock</span></dt><dd>Private: only you see it</dd>
        <dt><svg class="sheet-icon" aria-hidden="true"><use href="#i-flag"></use></svg><span class="visually-hidden">Flag</span></dt><dd>Due date</dd>
        <dt><svg class="sheet-icon" aria-hidden="true"><use href="#i-clock"></use></svg><span class="visually-hidden">Clock</span></dt><dd>Fixed time</dd>
        <dt>⚠</dt><dd>At risk (amber), overdue (red), or clashes with an event</dd>
        <dt><svg class="sheet-icon" aria-hidden="true"><use href="#i-graduation-cap"></use></svg><span class="visually-hidden">Graduation cap</span></dt><dd>Course task from Brightspace</dd>
        <dt><svg class="sheet-icon" aria-hidden="true"><use href="#i-calendar"></use></svg><span class="visually-hidden">Calendar</span></dt><dd>An event on your calendar, as a to-do</dd>
        <dt><svg class="sheet-icon" aria-hidden="true"><use href="#i-ticket"></use></svg><span class="visually-hidden">Ticket</span></dt><dd>Campus event</dd>
        <dt><svg class="sheet-icon" aria-hidden="true"><use href="#i-github"></use></svg><span class="visually-hidden">GitHub</span></dt><dd>Review or issue from GitHub (opens it)</dd>
        <dt><svg class="sheet-icon" aria-hidden="true"><use href="#i-kanban"></use></svg><span class="visually-hidden">Kanban</span></dt><dd>Ticket from Jira (opens it)</dd>
        <dt><svg class="sheet-icon" aria-hidden="true"><use href="#i-slack"></use></svg><span class="visually-hidden">Slack</span></dt><dd>Slack mention or direct message, in Needs you</dd>
        <dt><svg class="sheet-icon" aria-hidden="true"><use href="#i-utensils"></use></svg><span class="visually-hidden">Utensils</span></dt><dd>Campus events with free food</dd>
        <dt><svg class="sheet-icon" aria-hidden="true"><use href="#i-check"></use></svg><span class="visually-hidden">Check</span></dt><dd>Complete the task</dd>
        <dt><svg class="sheet-icon" aria-hidden="true"><use href="#i-more-horizontal"></use></svg><span class="visually-hidden">More</span></dt><dd>Menu for the task, or Calendars, Settings, Help and Sign out</dd>
        <dt><svg class="sheet-icon" aria-hidden="true"><use href="#i-sparkles"></use></svg><span class="visually-hidden">Sparkles</span></dt><dd>Proposed by Claude, until you approve it</dd>
        <dt><svg class="sheet-icon" aria-hidden="true"><use href="#i-repeat"></use></svg><span class="visually-hidden">Repeat</span></dt><dd>A habit's block, from Settings</dd>
        <dt><svg class="sheet-icon" aria-hidden="true"><use href="#i-bell"></use></svg><span class="visually-hidden">Bell</span></dt><dd>Nudges: Telegram reminds you of blocks (crossed out when off)</dd>
        <dt><svg class="sheet-icon" aria-hidden="true"><use href="#i-circle-alert"></use></svg><span class="visually-hidden">Alert</span></dt><dd>A feed failed: open Settings to see which</dd>
        <dt><svg class="sheet-icon" aria-hidden="true"><use href="#i-mail"></use></svg><span class="visually-hidden">Mail</span></dt><dd>Needs you: mail waiting on you</dd>
      </dl>
      <form method="dialog"><button type="submit" class="sheet-btn">Close</button></form>
    </dialog>

    <!-- A day's Oura numbers (docs/sheet-v5.md, "Day numbers"): src/sheet/oura-popover.mjs fills it. -->
    <dialog class="sheet-dialog sheet-oura-dialog" data-oura-day aria-labelledby="sheet-oura-day-title">
      <h2 id="sheet-oura-day-title">Oura</h2>
      <dl class="sheet-oura-list" data-oura-list></dl>
      <section data-oura-tips hidden aria-labelledby="sheet-oura-tips-title">
        <h3 id="sheet-oura-tips-title" class="sheet-oura-h">How to raise it</h3>
        <ul class="sheet-oura-tips" data-oura-tip-list></ul>
      </section>
      <section aria-labelledby="sheet-oura-week-title">
        <h3 id="sheet-oura-week-title" class="sheet-oura-h">Sleep this week</h3>
        <div data-oura-strip></div>
        <p class="small" data-oura-spread></p>
      </section>
      <p class="small">From your Oura ring. Only you see these.</p>
      <p class="sheet-dialog-end"><button type="button" class="sheet-btn" data-act="close-oura-day">Close</button></p>
    </dialog>
    <dialog class="sheet-dialog" data-calendars aria-labelledby="sheet-cal-title">
      <h2 id="sheet-cal-title">Calendars</h2>
      <p class="small">Your main Google calendar always shows. To add another one, like a class schedule: in Google Calendar, open Settings, click the calendar under "Settings for my calendars", and copy its Calendar ID from "Integrate calendar". Paste one ID per line.</p>
      <label class="visually-hidden" for="sheet-cal-ids">Extra calendar IDs, one per line</label>
      <textarea id="sheet-cal-ids" class="sheet-reflect" rows="4" spellcheck="false" placeholder="abc123@group.calendar.google.com"></textarea>
      <p class="small">Only you see these events. They never show on /now.</p>
      <div class="sheet-dialog-end">
        <button type="button" class="sheet-btn" data-act="close-calendars">Cancel</button>
        <button type="button" class="sheet-btn primary" data-act="save-calendars">Save</button>
      </div>
    </dialog>

    <dialog class="sheet-dialog" data-settings aria-labelledby="sheet-settings-title">
      <h2 id="sheet-settings-title">Settings</h2>

      <!-- Mail accounts (docs/sheet-sources.md, "/plan"): src/sheet/mail-settings.mjs fills the list. -->
      <section class="sheet-settings-part" aria-labelledby="sheet-mail-title">
        <h3 id="sheet-mail-title">Mail accounts</h3>
        <p class="small">Claude reads these, read-only, when you plan your day. Their sign-ins stay on the server.</p>
        <ul class="sheet-mail" data-mail-accounts></ul>
        <template data-mail-row>
          <li><span data-mail-name></span> <span class="small sheet-mail-error" data-mail-error></span> <button type="button" class="sheet-link" data-act="mail-remove">Remove</button></li>
        </template>
        <button type="button" class="sheet-btn" data-act="mail-connect">Connect an account</button>
      </section>

      <!-- Calendar (docs/sheet-v5.md, "/plan"): src/sheet/calendar-settings.mjs fills it. -->
      <section class="sheet-settings-part" aria-labelledby="sheet-calsync-title">
        <h3 id="sheet-calsync-title">Calendar</h3>
        <p class="small">The server saves your busy times (start and end only) every 10 minutes from your calendars' free/busy, never Time blocks.</p>
        <p><span role="status" data-busy-saved></span></p>
        <p class="small"><span data-cal-account></span> <span class="sheet-mail-error" data-cal-error></span></p>
        <button type="button" class="sheet-btn" data-act="cal-connect">Connect</button>
        <button type="button" class="sheet-link" data-act="cal-disconnect" hidden>Disconnect</button>
      </section>

      <!-- Oura (docs/sheet-v5.md, "Oura"): src/sheet/oura-settings.mjs fills it. -->
      <section class="sheet-settings-part" aria-labelledby="sheet-oura-title">
        <h3 id="sheet-oura-title">Oura</h3>
        <p class="small">The plan starts 30 minutes after you wake; your readiness, a short night or Rest Mode can lighten the day, and a ring workout ticks your Gym habit. Kept for 60 days, never shared and never sent to Claude: sleep start and end times; each day's sleep, readiness and activity scores and their contributors, hours slept, efficiency, deep and REM time, lowest and average heart rate, HRV, temperature deviation, steps and stress; Oura's bedtime window; workouts' day, times and type; Rest Mode's days; and a low-battery flag.</p>
        <p class="small"><span role="status" data-oura-status></span> <span class="sheet-mail-error" data-oura-error></span></p>
        <button type="button" class="sheet-btn" data-act="oura-connect">Connect</button>
        <button type="button" class="sheet-link" data-act="oura-disconnect" hidden>Disconnect</button>
        <!-- Wind-down (docs/sheet-v5.md, "Wind-down"): src/sheet/bedtime-settings.mjs fills it. -->
        <h4 id="sheet-sleep-title">Sleep</h4>
        <p class="small">No block or habit goes in the hour before bed, and Telegram says when to wind down and when it's bedtime. With no bedtime set, Oura's suggested one is used when it has one.</p>
        <p class="sheet-dialog-end"><label for="sheet-bedtime">Bedtime</label> <input id="sheet-bedtime" type="time" step="900"> <button type="button" class="sheet-btn" data-act="bedtime-ease" aria-pressed="true">Ease in</button> <button type="button" class="sheet-btn" data-act="wind-down" aria-pressed="true">Wind-down</button> <button type="button" class="sheet-btn primary" data-act="save-bedtime">Save</button></p>
        <p class="small" role="status" data-bedtime-note></p>
        <p><button type="button" class="sheet-link" data-act="oura-week">Sleep this week</button></p>
      </section>

      <!-- Interest profile (docs/sheet-claude.md): src/sheet/planner.mjs fills and saves it. -->
      <section class="sheet-settings-part" aria-labelledby="sheet-int-title">
        <h3 id="sheet-int-title">Interest profile</h3>
        <p class="small">A few plain lines on what you like: topics, clubs, career goals, and what you'd skip. Claude picks campus events against them when it plans your day.</p>
        <label class="visually-hidden" for="sheet-interests">Your interest profile, a few lines</label>
        <textarea id="sheet-interests" class="sheet-reflect" rows="6" placeholder="Robotics, embedded systems, free food"></textarea>
        <p class="small">Only you and Claude read this. It never shows on /now.</p>
        <p class="sheet-dialog-end"><span class="small" role="status" data-interests-note></span> <button type="button" class="sheet-btn primary" data-act="save-interests">Save</button></p>
      </section>

      <!-- Workload cap (docs/sheet-v5.md, "/plan"): src/sheet/planner.mjs fills and saves it. -->
      <section class="sheet-settings-part" aria-labelledby="sheet-cap-title">
        <h3 id="sheet-cap-title">Workload cap</h3>
        <p class="small">The most hours of blocks Claude plans in a day, and the load bar's full mark.</p>
        <p class="sheet-dialog-end"><label for="sheet-cap">Hours a day</label> <input id="sheet-cap" class="sheet-cap" type="number" min="1" max="16" step="0.5" inputmode="decimal"> <span class="small" role="status" data-cap-note></span> <button type="button" class="sheet-btn primary" data-act="save-cap">Save</button></p>
      </section>

      <!-- Habits (docs/sheet-v5.md, "/plan"): src/sheet/habit-settings.mjs fills and saves them. -->
      <section class="sheet-settings-part" aria-labelledby="sheet-habits-title">
        <h3 id="sheet-habits-title">Habits</h3>
        <p class="small">Claude places these around your tasks on their days, starting within the ideal time ± flex. Firm ones go in before tasks, flexible ones after hard deadlines; one that can't fit is left out that day. They never show on /now.</p>
        <ul class="sheet-mail" data-habits></ul>
        <form class="sheet-habit-form" data-habit-form>
          <label>Name <input name="name" type="text" maxlength="40" required placeholder="Gym"></label>
          <fieldset><legend>Days</legend> <label><input type="checkbox" name="days[]" value="1"> Mon</label> <label><input type="checkbox" name="days[]" value="2"> Tue</label> <label><input type="checkbox" name="days[]" value="3"> Wed</label> <label><input type="checkbox" name="days[]" value="4"> Thu</label> <label><input type="checkbox" name="days[]" value="5"> Fri</label> <label><input type="checkbox" name="days[]" value="6"> Sat</label> <label><input type="checkbox" name="days[]" value="7"> Sun</label></fieldset>
          <label>Ideal time <input name="ideal" type="time" value="12:00" required></label>
          <label>Minutes <input name="minutes" class="sheet-cap" type="number" min="15" max="240" step="5" value="30" required></label>
          <label>Flex ± <input name="flex_min" class="sheet-cap" type="number" min="0" max="240" step="5" value="30" required></label>
          <label>Defence <select name="defence"><option value="flexible">Flexible</option><option value="firm">Firm</option></select></label>
          <p class="sheet-dialog-end"><span class="small" role="status" data-habit-note></span> <button type="submit" class="sheet-btn primary">Add habit</button></p>
        </form>
      </section>

      <!-- Replans (docs/sheet-v5.md, "/plan"): src/sheet/replan-settings.mjs fills and saves it. -->
      <section class="sheet-settings-part" aria-labelledby="sheet-replans-title">
        <h3 id="sheet-replans-title">Replans</h3>
        <p class="small">When something changes during the day (a busy time lands on a block, a course task comes due), Claude plans the rest of the day again, at most once an hour. A replan may move a block it placed until the block starts; one you moved stays put.</p>
        <p class="sheet-dialog-end"><span class="small" role="status" data-replans-note></span> <button type="button" class="sheet-btn" data-act="replans" aria-pressed="false">Replans</button></p>
      </section>

      <section class="sheet-settings-part" aria-labelledby="sheet-auto-approve-title">
        <h3 id="sheet-auto-approve-title">Auto-approve</h3>
        <p class="small">A plan's blocks count as soon as Claude makes them: they get calendar events and nudges without Approve all. Move or remove any of them here.</p>
        <p class="sheet-dialog-end"><span class="small" role="status" data-auto-approve-note></span> <button type="button" class="sheet-btn" data-act="auto-approve" aria-pressed="false">Auto-approve</button></p>
      </section>

      <!-- Enrollment time (docs/sheet-v5.md, "/plan"): src/sheet/enrollment-settings.mjs fills and saves it. -->
      <section class="sheet-settings-part" aria-labelledby="sheet-enroll-title">
        <h3 id="sheet-enroll-title">Enrollment</h3>
        <p class="small">When your spring enrollment opens. It becomes a private task at that time.</p>
        <p class="sheet-dialog-end"><label for="sheet-enroll">Opens</label> <input id="sheet-enroll" type="datetime-local"> <span class="small" role="status" data-enroll-note></span> <button type="button" class="sheet-btn primary" data-act="save-enroll">Save</button></p>
      </section>

      <!-- Feeds status (docs/sheet-sources.md, "/plan"): src/sheet/feed-status.mjs fills the list. -->
      <section class="sheet-settings-part" aria-labelledby="sheet-feeds-title">
        <h3 id="sheet-feeds-title">Feeds</h3>
        <p class="small">What the server reads every hour, and how the last read went. GitHub and Jira read "not connected" until their tokens are set.</p>
        <ul class="sheet-mail" data-feeds></ul>
        <!-- v5 SRC1: the orgs whose GitHub reviews and issues become tasks; feed-status.mjs saves them. -->
        <p class="sheet-dialog-end"><label for="sheet-gh-orgs">GitHub orgs</label> <input id="sheet-gh-orgs" type="text" placeholder="acme-robotics, other-org"> <span class="small" role="status" data-gh-note></span> <button type="button" class="sheet-btn primary" data-act="save-gh-orgs">Save</button></p>
      </section>

      <!-- Pace (docs/sheet-v5.md, "/plan"): src/sheet/pace-settings.mjs fills the list. -->
      <section class="sheet-settings-part" aria-labelledby="sheet-pace-title">
        <h3 id="sheet-pace-title">Pace</h3>
        <p class="small">How long each kind of task really takes next to its estimate, from your Finished? answers in Telegram. Claude sizes blocks by it once a kind has 5.</p>
        <ul class="sheet-mail" data-pace></ul>
      </section>

      <!-- Triage rules (docs/sheet-v5.md, "/plan"): src/sheet/triage-settings.mjs fills and saves them. -->
      <section class="sheet-settings-part" aria-labelledby="sheet-triage-title">
        <h3 id="sheet-triage-title">Triage rules</h3>
        <p class="small">Mail from a sender or domain you always or never want in Needs you. Never show holds whatever Claude decides.</p>
        <ul class="sheet-mail" data-triage-rules></ul>
        <form class="sheet-dialog-end" data-triage-add>
          <label for="sheet-triage-pattern">Address or domain</label>
          <input id="sheet-triage-pattern" name="pattern" type="text" required minlength="3" maxlength="254" pattern="[^\s]+" placeholder="jobs@acme.com or acme.com" autocomplete="off">
          <label class="visually-hidden" for="sheet-triage-action">Rule</label>
          <select id="sheet-triage-action" name="action"><option value="never">Never show</option><option value="always">Always show</option></select>

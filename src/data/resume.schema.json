{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lisul-elvi.com/resume.schema.json",
  "title": "resume.json",
  "description": "Generated by tools/tex2json.py from latex/onepager.tex. Every string is the text the PDF shows, with LaTeX markup removed. The phone number is included because it is on the PDF, but the site never renders it. There is no offer note: offer tags are banned on the site. The site's schema must mirror this file.",
  "type": "object",
  "additionalProperties": false,
  "required": ["basics", "education", "experience", "projects", "skills", "meta"],
  "properties": {
    "basics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "citizenship", "email", "phone", "links"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "citizenship": { "type": "string", "minLength": 1, "description": "As printed, e.g. 'U.S. Citizen'." },
        "email": { "type": "string", "pattern": "^[^@\\s]+@[^@\\s]+$" },
        "phone": { "type": "string", "minLength": 1, "description": "On the PDF only. The site must never render it." },
        "links": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "url"],
            "properties": {
              "label": { "type": "string", "minLength": 1, "description": "As printed, e.g. 'linkedin.com/in/lisul'." },
              "url": { "type": "string", "pattern": "^https://" }
            }
          }
        }
      }
    },
    "education": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["school", "degree", "date", "gpa", "items"],
        "properties": {
          "school": { "type": "string", "minLength": 1 },
          "degree": { "type": "string", "minLength": 1 },
          "honorific": { "type": "string", "minLength": 1, "description": "Optional; the current one-pager has none in the heading (Presidential Scholar is in the Honors item)." },
          "date": { "type": "string", "minLength": 1, "description": "As printed, e.g. 'Expected May 2028'." },
          "gpa": { "type": "string", "minLength": 1, "description": "As printed, e.g. 'GPA: 3.86/4.00'." },
          "items": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "description": "Honors, teaching and coursework lines, label included ('Coursework: ...')." }
        }
      }
    },
    "experience": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["company", "title", "dates", "location", "stack", "bullets"],
        "properties": {
          "company": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1, "description": "The role line before the comma, e.g. 'Software Engineer Intern'." },
          "team": { "type": "string", "minLength": 1, "description": "The role line after the comma, e.g. 'Onboard Systems'. Absent when the role line has no comma." },
          "dates": { "type": "string", "minLength": 1, "description": "As printed, with an en dash: 'Jun 2026 – Aug 2026'." },
          "location": { "type": "string", "minLength": 1 },
          "stack": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "description": "The technology list after '|' on the role line; the site's tags." },
          "bullets": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "projects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "title", "url", "dates", "stack", "bullets"],
        "properties": {
          "slug": { "type": "string", "pattern": "^[a-z0-9]+$", "description": "First word of the linked title, lowercased: the write-up lives at /projects/<slug>/." },
          "title": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "pattern": "^https://" },
          "role": { "type": "string", "minLength": 1, "description": "Absent when the heading is 'title | stack'." },
          "dates": { "type": "string", "minLength": 1, "description": "As printed, with an en dash: 'Aug 2024 – Present'." },
          "stack": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "bullets": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "description": "bullets[0] is the outcome line on the project card." }
        }
      }
    },
    "skills": {
      "type": "object",
      "additionalProperties": false,
      "required": ["languages", "frameworks", "tools"],
      "properties": {
        "languages": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "description": "The 'Languages:' line." },
        "frameworks": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "description": "The 'Frameworks & Libraries:' line." },
        "tools": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "description": "The 'Tools:' line." }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "generatedAt"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
        "generatedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" }
      }
    }
  }
}

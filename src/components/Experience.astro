---
// Experience entries: a date column, "Role · Company", one context sentence,
// every résumé bullet verbatim, and technology tags.
import { siteConfig } from "../config";
import Tags from "./Tags.astro";
import { resume } from "../data/resume";
import { frontmatter as home } from "../content/home.md";
---

<section class="wrap" id="experience" aria-labelledby="experience-h">
  <h2 id="experience-h">Experience</h2>
  <ol class="entries">
    {resume.experience.map((e) => (
      <li class="entry">
        <p class="dates">{e.dates}</p>
        <div>
          <h3>{e.title} · {e.company}</h3>
          <p class="meta">{[e.team, e.location].filter(Boolean).join(" · ")}</p>
          {home.roles?.[e.company] && <p class="summary">{home.roles[e.company]}</p>}
          <ul class="bullets">{e.bullets.map((b) => <li>{b}</li>)}</ul>
          <Tags items={e.stack} />
        </div>
      </li>
    ))}
  </ol>
  <p><a class="more" href={siteConfig.resumePdf}>View full résumé →</a></p>
</section>

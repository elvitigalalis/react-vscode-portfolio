---
import { resume } from "../data/resume";
---

<section class="wrap" id="education" aria-labelledby="education-h">
  <h2 id="education-h">Education</h2>
  {resume.education.map((e) => (
    <div class="entry">
      <p class="dates">{e.date}</p>
      <div>
        <h3>{e.degree} · {e.school}</h3>
        <p class="meta">{[e.honorific, e.gpa].filter(Boolean).join(" · ")}</p>
        <ul class="bullets">{e.items.map((i) => <li>{i}</li>)}</ul>
      </div>
    </div>
  ))}
</section>

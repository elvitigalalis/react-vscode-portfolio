---
// Project cards: photo, dates, title and role, summary, the résumé bullets verbatim, tags,
// and Write-up / Code / Demo buttons, each shown only when its target exists.
// Photos come in 640 px and 360 px widths (<name>.webp, <name>-360.webp). The first card's
// photo can be in a phone's first viewport, so it is not lazy-loaded.
// A project's photo and demo come from its write-up's front matter, or from home.md for a
// project with no write-up.
import { getCollection } from "astro:content";
import Tags from "./Tags.astro";
import { resume } from "../data/resume";
import { frontmatter as home } from "../content/home.md";

const writeups = new Map((await getCollection("writeups")).map((w) => [w.id, w.data]));
---

<section class="wrap" id="projects" aria-labelledby="projects-h">
  <h2 id="projects-h">Projects</h2>
  {resume.projects.map((p, i) => {
    const card = home.projects?.[p.slug] ?? {};
    const w = writeups.get(p.slug);
    const extra = { summary: card.summary, photo: w ? w.photo : card.photo, demo: w ? w.demo : card.demo };
    return (
      <article class="card">
        {extra.photo && (
          <img
            src={extra.photo.src}
            srcset={`${extra.photo.src.replace(/\.webp$/, "-360.webp")} 360w, ${extra.photo.src} 640w`}
            sizes="(max-width: 40rem) calc(100vw - 5.5rem), 18rem"
            alt={extra.photo.alt}
            width="640"
            height="480"
            loading={i === 0 ? "eager" : "lazy"}
            fetchpriority={i === 0 ? "high" : undefined}
            decoding="async"
          />
        )}
        <div>
          <p class="dates">{p.dates}</p>
          <h3>{p.title}{p.role && <span class="role"> · {p.role}</span>}</h3>
          {extra.summary && <p class="summary">{extra.summary}</p>}
          <ul class="bullets">{p.bullets.map((b) => <li>{b}</li>)}</ul>
          <Tags items={p.stack} />
          <p class="buttons">
            {writeups.has(p.slug) && <a class="btn primary" href={`/projects/${p.slug}/`}>Write-up</a>}
            <a class="btn" href={p.url}>Code</a>
            {extra.demo && <a class="btn" href={extra.demo.url}>{extra.demo.label}</a>}
          </p>
        </div>
      </article>
    );
  })}
</section>

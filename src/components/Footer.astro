---
// "Updated <date>" is written at build time, so the page never shows a stale year.
// "built from <commit>" appears when the build knows its commit.
import { execSync } from "node:child_process";
import { siteConfig } from "../config";
import { profileOf, resume } from "../data/resume";

const now = new Date();
const updated = now.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "America/New_York" });
let commit = process.env.GITHUB_SHA ?? "";
if (!commit) {
  try { commit = execSync("git rev-parse HEAD", { encoding: "utf8", stdio: ["ignore", "pipe", "ignore"] }).trim(); } catch {}
}
const short = commit.slice(0, 7);
const repo = "https://github.com/elvitigalalis/react-vscode-portfolio";
---

<footer class="footer">
  <div class="wrap">
    <ul class="contact">
      <li><a href={`mailto:${resume.basics.email}`}>Email</a></li>
      {resume.basics.links.map((l) => <li><a href={l.url}>{profileOf(l.url) ?? l.label}</a></li>)}
      <li><a href={siteConfig.resumePdf}>Résumé (PDF)</a></li>
    </ul>
    <p class="small">
      Updated <time datetime={now.toISOString().slice(0, 10)}>{updated}</time>
      {short && <> · built from <a href={`${repo}/commit/${commit}`}><code>{short}</code></a></>}
    </p>
  </div>
</footer>

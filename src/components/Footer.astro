---
// "Updated <date>" is written at build time, so the page never shows a stale year. The text
// and its datetime are both the build's date in New York, so they never name different days.
// "built from <commit>" appears when the build knows its commit.
import { commit, shortCommit } from "../build-info.mjs";
import { siteConfig } from "../config";
import { profileOf, resume } from "../data/resume";

const now = new Date();
const timeZone = "America/New_York";
const updated = now.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric", timeZone });
const iso = now.toLocaleDateString("en-CA", { timeZone }); // YYYY-MM-DD
const repo = "https://github.com/elvitigalalis/react-vscode-portfolio";
---

<footer class="footer">
  <div class="wrap">
    <ul class="contact">
      <li><a href={`mailto:${resume.basics.email}`}>Email</a></li>
      {resume.basics.links.map((l) => <li><a href={l.url}>{profileOf(l.url) ?? l.label}</a></li>)}
      <li><a href={siteConfig.resumePdf}>Résumé (PDF)</a></li>
      <li><a href="/now/">Now</a></li>
    </ul>
    <p class="small">
      Updated <time datetime={iso}>{updated}</time>
      {shortCommit && <> · built from <a href={`${repo}/commit/${commit}`}><code>{shortCommit}</code></a></>}
    </p>
  </div>
</footer>

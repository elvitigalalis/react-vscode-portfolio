---
// The first screen: who, what, where, and the two buttons, all as plain text, with a plant grown
// from this build's commit beside them (src/plant/grow.mjs). The plant is decoration only.
import { execSync } from "node:child_process";
import { siteConfig } from "../config";
import { growPlant } from "../plant/grow.mjs";
import { profileLink, resume } from "../data/resume";
import { frontmatter as home } from "../content/home.md";

const { basics, education, experience } = resume;
const graduating = education[0].date.replace(/^Expected\s+/, "");
const current = experience.filter((e) => /Present$/.test(e.dates));
const github = profileLink("GitHub");
const linkedin = profileLink("LinkedIn");

let commit = process.env.GITHUB_SHA ?? "";
if (!commit) {
  try { commit = execSync("git rev-parse HEAD", { encoding: "utf8", stdio: ["ignore", "pipe", "ignore"] }).trim(); } catch {}
}
const seed = commit.slice(0, 7) || "lisul";
---

<section class="hero wrap" id="top" aria-labelledby="name">
  <div class="hero-text">
    <p class="kicker">{home.kicker}</p>
    <h1 id="name">{basics.name}</h1>
    <p class="thesis">{home.thesis}</p>
    <p class="cta">
      <a class="btn primary" href="#projects">Projects →</a>
      <a class="btn" href={siteConfig.resumePdf}>Résumé (PDF)</a>
    </p>
    <dl class="kv">
      <dt>Location</dt><dd>{home.location}</dd>
      <dt>Graduating</dt><dd>{graduating}</dd>
      {current.length > 0 && <><dt>Currently</dt><dd>{current.map((e) => `${e.title}, ${e.company}`).join("; ")}</dd></>}
      <dt>Citizenship</dt><dd>{basics.citizenship}</dd>
    </dl>
    <ul class="contact">
      <li><a href={`mailto:${basics.email}`}>{basics.email}</a></li>
      {github && <li><a href={github.url}>{github.label}</a></li>}
      {linkedin && <li><a href={linkedin.url}>{linkedin.label}</a></li>}
    </ul>
  </div>
  <figure class="hero-plant" aria-hidden="true">
    <Fragment set:html={growPlant(seed)} />
    <figcaption>Grown from commit {seed}</figcaption>
  </figure>
</section>

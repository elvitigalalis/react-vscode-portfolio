{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "preset": "lighthouse:recommended",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.95,
                "aggregationMethod": "median-run"
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 1
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 1
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 1
              }
            ],
            "largest-contentful-paint": [
              "error",
              {
                "maxNumericValue": 2500
              }
            ],
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.1
              }
            ],
            "total-blocking-time": [
              "error",
              {
                "maxNumericValue": 200
              }
            ],
            "resource-summary:script:size": [
              "error",
              {
                "maxNumericValue": 5120
              }
            ],
            "resource-summary:font:size": [
              "error",
              {
                "maxNumericValue": 0
              }
            ],
            "resource-summary:third-party:count": [
              "error",
              {
                "maxNumericValue": 0
              }
            ],
            "uses-text-compression": "off",
            "image-delivery-insight": "warn"
          }
        },
        {
          "matchingUrlPattern": "^(?!.*/projects/).*$",
          "assertions": {
            "resource-summary:total:size": [
              "error",
              {
                "maxNumericValue": 102400
              }
            ],
            "resource-summary:total:count": [
              "error",
              {
                "maxNumericValue": 15
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "/projects/",
          "assertions": {
            "resource-summary:total:size": [
              "error",
              {
                "maxNumericValue": 307200
              }
            ]
          }
        },
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "largest-contentful-paint": [
              "warn",
              {
                "maxNumericValue": 1500
              }
            ],
            "cumulative-layout-shift": [
              "warn",
              {
                "maxNumericValue": 0.02
              }
            ],
            "total-blocking-time": [
              "warn",
              {
                "maxNumericValue": 50
              }
            ]
          }
        }
      ]
    }
  }
}
